@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# ==============================================
# 1. MAIN PERSON (Azzylegacy / Awais Rafiq)
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/>
    a schema:Person, 
      schema:MusicGroup, 
      schema:Photographer, 
      schema:CreativeWork ;
    
    # ---- BASIC INFO ----
    schema:name "Azzylegacy" ;
    schema:alternateName "Awais Rafiq" ;
    schema:additionalName "Awais" ;
    schema:familyName "Rafiq" ;
    schema:description """Azzylegacy is a multi-talented Music Producer, Cinematographer, 
                          and Photographer from Pakistan. Specializes in Hip Hop beats, 
                          Drill music, Event Photography (Weddings, Birthdays, Bridal Shoots), 
                          and Commercial Videography."""@en ;
    
    # ---- PROFESSIONAL TITLES ----
    schema:jobTitle "Music Producer", 
                    "Cinematographer", 
                    "Photographer", 
                    "Video Editor",
                    "Event Photographer",
                    "Wedding Cinematographer",
                    "Bridal Shoot Specialist" ;
    
    # ---- KNOWLEDGE DOMAINS ----
    schema:knowsAbout "Music Production", 
                      "Cinematography", 
                      "Photography", 
                      "Event Photography",
                      "Wedding Photography",
                      "Bridal Photography",
                      "Birthday Photography",
                      "Video Editing",
                      "Beat Making",
                      "FL Studio",
                      "Adobe Premiere Pro",
                      "DaVinci Resolve",
                      "Adobe Lightroom" ;
    
    # ---- GENRES ----
    schema:genre "Hip Hop", 
                 "Drill", 
                 "Rap", 
                 "Trap", 
                 "Lo-fi",
                 "Event Photography",
                 "Wedding Cinematography",
                 "Portrait Photography" ;
    
    # ---- LOCATION ----
    schema:homeLocation [
        a schema:Place ;
        schema:name "Pakistan" ;
        schema:address [
            a schema:PostalAddress ;
            schema:addressCountry "PK" ;
            schema:addressRegion "Punjab" ;
            schema:addressLocality "Lahore"
        ] ;
        geo:latitude "31.5204" ;
        geo:longitude "74.3587"
    ] ;
    
    # ---- SOCIAL & WEB ----
    schema:url <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:sameAs <https://github.com/awaismehar404> ,
                  <https://www.instagram.com/Azzylegacy> ,
                  <https://www.tiktok.com/@Azzylegacy> ,
                  <https://www.youtube.com/@Azzylegacy> ,
                  <https://soundcloud.com/azzylegacy> ,
                  <https://www.facebook.com/Azzylegacy> ,
                  <https://www.linkedin.com/in/azzylegacy> ;
    
    # ---- PROFILE IMAGES ----
    schema:image <https://awaismehar404.github.io/Azzylegacy-/images/profile.jpg> ;
    schema:logo <https://awaismehar404.github.io/Azzylegacy-/images/logo.png> ;
    
    # ---- PERSONAL INFO ----
    schema:birthDate "1998-10-25"^^xsd:date ;
    schema:nationality <http://id.loc.gov/vocabulary/countries/pk> ;
    schema:gender "Male" ;
    schema:telephone "+92-300-1234567" ;
    schema:email "azzylegacy@protonmail.com" .

# ==============================================
# 2. VIDEOGRAPHY / CINEMATOGRAPHY PORTFOLIO
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/videography>
    a schema:CreativeWork, schema:VideoObject ;
    schema:name "Azzylegacy Cinematography Reel" ;
    schema:creator <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:description "Professional Drone shots, cinematic videos, and commercial music visuals."@en ;
    schema:genre "Cinematography", "Drill Videos", "Commercial" ;
    schema:videoQuality "4K" ;
    schema:uploadDate "2024-01-01"^^xsd:date .

# ==============================================
# 3. MUSIC RECORDING / BEAT PRODUCTION
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/music>
    a schema:MusicRecording, schema:MusicAlbum ;
    schema:name "Azzylegacy Beats Vol.1" ;
    schema:byArtist <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:genre "Hip Hop", "Drill", "Rap", "Trap" ;
    schema:inLanguage "en" ;
    schema:duration "PT3M45S" ;
    schema:datePublished "2024-01-15"^^xsd:date ;
    schema:url <https://soundcloud.com/azzylegacy> .

# ==============================================
# 4. PHOTOGRAPHY PORTFOLIO
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/photography>
    a schema:Photograph, schema:ImageObject ;
    schema:name "Azzylegacy Photography Portfolio" ;
    schema:creator <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:description "Portrait, Landscape, and Event Photography from Pakistan."@en ;
    schema:copyrightHolder <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" .

# ==============================================
# 5. BEAT PRODUCTION SKILLS (SPECIFIC KNOWLEDGE)
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/skills>
    a schema:DefinedTermSet ;
    schema:name "Azzylegacy's Production Skills" ;
    schema:hasDefinedTerm [
        a schema:DefinedTerm ;
        schema:name "FL Studio" ;
        schema:description "Advanced beat making, mixing, and mastering"
    ], [
        a schema:DefinedTerm ;
        schema:name "Adobe Premiere Pro" ;
        schema:description "Professional video editing and color grading"
    ], [
        a schema:DefinedTerm ;
        schema:name "Adobe Lightroom" ;
        schema:description "Photo editing and visual enhancement"
    ], [
        a schema:DefinedTerm ;
        schema:name "DaVinci Resolve" ;
        schema:description "Cinematic color correction"
    ] .

# ==============================================
# 6. EVENT CATEGORIES: BIRTHDAY PHOTOGRAPHY
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/events/birthday>
    a schema:Event, schema:Photograph ;
    schema:name "Azzylegacy Birthday Photography Services" ;
    schema:creator <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:description """Professional birthday photography services. 
                          Candid moments, cake cutting ceremonies, 
                          family portraits, and themed birthday shoots."""@en ;
    schema:eventType "Birthday Party", "Birthday Shoot" ;
    schema:audience [
        a schema:Audience ;
        schema:audienceType "Children", "Teenagers", "Adults"
    ] ;
    schema:offers [
        a schema:Offer ;
        schema:name "Birthday Photography Package" ;
        schema:price "15000" ;
        schema:priceCurrency "PKR" ;
        schema:availability <http://schema.org/InStock>
    ] .

# ==============================================
# 7. EVENT CATEGORIES: WEDDING PHOTOGRAPHY
# ==============================================
<https://awaismehar404.github.io/Azzylegacy-/events/wedding>
    a schema:Event, schema:Photograph, schema:VideoObject ;
    schema:name "Azzylegacy Wedding Cinematography & Photography" ;
    schema:creator <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:description """Premium wedding photography and cinematic 
                          videography services. Includes pre-wedding shoots, 
                          mehndi, baraat, walima, and bridal portraits."""@en ;
    schema:eventType "Wedding", "Marriage", "Nikkah" ;
    schema:audience [
        a schema:Audience ;
        schema:audienceType "Couples", "Families"
    ] ;
    schema:offers [
        a schema:Offer ;
        schema:name "Complete Wedding Package" ;
        schema:price "85000" ;
        schema:priceCurrency "PKR" ;
        schema:availability <http://schema.org/InStock>
    ], [
        a schema:Offer ;
        schema:name "Bridal Shoot Only" ;
        schema:price "25000" ;
        schema:priceCurrency "PKR" ;
        schema:availability <http://schema.org/InStock>
    ] .

