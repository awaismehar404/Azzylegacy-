<https://awaismehar404.github.io/Azzylegacy-/reviews>
    a schema:Review ;
    schema:itemReviewed <https://awaismehar404.github.io/Azzylegacy-/> ;
    schema:reviewBody """Azzylegacy captured our wedding beautifully! 
